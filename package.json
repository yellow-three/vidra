    "eslint": "~10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.72.1",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
