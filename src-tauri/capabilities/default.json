{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-remove"
  ]
}
