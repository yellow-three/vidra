{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidra",
  "version": "0.1.0",
  "identifier": "io.github.yellow-three.vidra",
  "build": {
    "beforeDevCommand": "npm run sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vidra",
        "width": 1050,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ytd-yt-dlp",
      "binaries/ytd-ffmpeg",
      "binaries/ytd-deno"
    ],
    "resources": {
      "binaries/licenses/": "licenses/"
    },
    "linux": {
      "deb": {
        "conflicts": [
          "you-tube-downloader"
        ],
        "replaces": [
          "you-tube-downloader"
        ]
      },
      "rpm": {
        "conflicts": [
          "you-tube-downloader"
        ],
        "obsoletes": [
          "you-tube-downloader"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4OUFFOEZBREI3MTAyQzYKUldUR0FuSGIrdWlhbUxYcWhCelZaTnUrSHJ5U2N6cnBBaVc1YjlOMU9lbUtxbmtRYnMvRFc5cDEK",
      "endpoints": [
        "https://github.com/yellow-three/vidra-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
